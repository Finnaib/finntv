{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": [
        "core/**",
        "data/**",
        "m3u/**",
        "config.php",
        "xtream_config.json"
      ]
    },
    "player/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "headers": [
    {
      "source": "/m3u/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-mpegurl"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/player/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/player_api.php",
      "destination": "/api/player_api.php"
    },
    {
      "source": "/get.php",
      "destination": "/api/get.php"
    },
    {
      "source": "/live/:path*",
      "destination": "/api/live.php?type=live"
    },
    {
      "source": "/movie/:path*",
      "destination": "/api/live.php?type=movie"
    },
    {
      "source": "/series/:path*",
      "destination": "/api/live.php?type=series"
    },
    {
      "source": "/panel_api.php",
      "destination": "/api/panel_api.php"
    },
    {
      "source": "/xmltv.php",
      "destination": "/api/xmltv.php"
    },
    {
      "source": "/player",
      "destination": "/player/index.html"
    },
    {
      "source": "/player/",
      "destination": "/player/index.html"
    }
  ]
}
