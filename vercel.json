{
    "version":  2,
    "builds":  [
                   {
                       "src":  "api/*.php",
                       "use":  "vercel-php@0.7.1",
                       "config":  {
                                      "includeFiles":  [
                                                           "core/**",
                                                           "data/data.json",
                                                           "data/id_map.json",
                                                           "config.php"
                                                       ]
                                  }
                   },
                   {
                       "src":  "player/index.php",
                       "use":  "vercel-php@0.7.1"
                   },
                   {
                       "src":  "!(api/**)",
                       "use":  "@vercel/static"
                   }
               ],
    "routes":  [
                   {
                       "src":  "/api/m3u.php",
                       "dest":  "/api/m3u.php"
                   },
                   {
                       "src":  "/api/xtream_proxy.php",
                       "dest":  "/api/xtream_proxy.php"
                   },
                   {
                       "src":  "/m3u/(.*\\.m3u)",
                       "dest":  "/m3u/$1",
                       "headers":  {
                                       "Content-Type":  "application/x-mpegurl"
                                   }
                   },

                   {
                       "src":  "/player_api.php",
                       "dest":  "/api/player_api.php"
                   },
                   {
                       "src":  "/get.php",
                       "dest":  "/api/get.php"
                   },
                   {
                       "src":  "/live/(.*)",
                       "dest":  "/api/live.php?type=live"
                   },
                   {
                       "src":  "/movie/(.*)",
                       "dest":  "/api/live.php?type=movie"
                   },
                   {
                       "src":  "/series/(.*)",
                       "dest":  "/api/live.php?type=series"
                   },
                   {
                       "src":  "/panel_api.php",
                       "dest":  "/api/panel_api.php"
                   },
                   {
                       "src":  "/xmltv.php",
                       "dest":  "/api/xmltv.php"
                   },
                   {
                       "src":  "/user_portal.html",
                       "dest":  "/user_portal.html"
                   },
                   {
                       "src":  "/admin.html",
                       "dest":  "/admin.html"
                   },
                   {
                       "src":  "/player/(.*)",
                       "dest":  "/player/$1"
                   },
                   {
                       "src":  "/",
                       "dest":  "/index.html"
                   },
                   {
                       "src":  "/player/index.html",
                       "dest":  "/player/index.php"
                   }
               ]
}
